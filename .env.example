# Copy to .env and fill in. The .env file is gitignored.
# These VITE_ vars are embedded in the client bundle and are safe to be public
# (the anon key is protected by Row Level Security), but the file itself should
# not be versioned so real projects don't leak future server-only additions.
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"
VITE_SUPABASE_PROJECT_ID="YOUR_PROJECT"

# ---------------------------------------------------------------------------
# Server-only secrets — set these with `supabase secrets set`, NEVER here:
#   ADMIN_TOKEN                 long random string; gates the admin panel
#   RESEND_API_KEY             transactional email
#   NOTION_TOKEN               newsletter subscriber store
#   NOTION_SUBSCRIBERS_DB_ID   newsletter subscriber store
#   LOVABLE_API_KEY            translate function
#   SUPABASE_SERVICE_ROLE_KEY  sync-notion-readings
#   CRON_SECRET                (recommended) header check for sync-notion-readings
